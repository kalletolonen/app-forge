# Copy to apps/demo/.env.local for local development

APP_ID=demo
NEXT_PUBLIC_APP_NAME=Demo Records

# Local SQLite file (relative to packages/database when running drizzle-kit)
LOCAL_DATABASE_URL=file:../../.data/demo.sqlite

# Auth — generate with: openssl rand -base64 32
# Local: apps/demo/.env.local. CI: GitHub Actions secret BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:43123
NEXT_PUBLIC_BETTER_AUTH_URL=http://127.0.0.1:43123

# Cloudflare go-live (repo root or CI)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: attach {subdomain}.{ROOT_DOMAIN} on `pnpm go-live`
# ROOT_DOMAIN=yourdomain.com
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_WORKERS_DEV_SUBDOMAIN=crud-factory
