{
  "name": "vite-d1-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'wrangler dev --ip 127.0.0.1 --port 8787 & vite --port 5174 --strictPort --host 127.0.0.1'",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply crud-SLUG --local",
    "check-types": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@repo/database": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250912.0",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "7.0.2",
    "vite": "^7.1.5",
    "wrangler": "^4.36.0"
  }
}
