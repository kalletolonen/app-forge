{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crud-SLUG",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crud-SLUG",
      "database_id": "REPLACE_AFTER_PROVISION",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "vars": {
    "APP_ID": "SLUG",
    "NEXT_PUBLIC_APP_NAME": "DISPLAY_NAME"
  }
}
